# Postgres connection string (Neon: Dashboard → Connect → pooled connection string)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-min-32-chars-xxxxxxxxxxxxxxxxxx"

# Public app URL (used by Better Auth, Eden and the payment return/webhook URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments — which gateway new checkouts use
PAYMENT_PROVIDER="mercadopago"
# Mercado Pago → Tus integraciones → (tu app) → Credenciales
MERCADOPAGO_ACCESS_TOKEN=""
# Mercado Pago → Tus integraciones → (tu app) → Webhooks → Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=""

# Accounts (optional; buying never needs one). Each method appears once configured.
# "Continuar con Google": Google Cloud → APIs & Services → Credentials → OAuth client ID
# (Web). Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Sign-in codes by e-mail (resend.com → API Keys; verify the sender's domain).
# Without it, production falls back to e-mail + password; development logs codes.
RESEND_API_KEY=""
# EMAIL_FROM="Astramia <hola@astramia.app>"

# PostHog (us.posthog.com → Project settings → Project token). Without it,
# analytics and session replay stay off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
# US cloud: https://us.i.posthog.com · EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Meta (Events Manager → Configuración → API de Conversiones). The browser
# pixel needs nothing; the server's copy of Purchase needs the access token.
# Without it, only the pixel reports (and ad blockers win).
META_CAPI_ACCESS_TOKEN=""
# Optional: code from "Probar eventos", so test purchases aren't counted.
# META_CAPI_TEST_EVENT_CODE=""

# Vercel AI Gateway (vercel.com → AI Gateway → API Keys). Not needed on Vercel (OIDC).
AI_GATEWAY_API_KEY=""
# Optional model overrides (AI Gateway ids). Defaults: src/core/ai/domain/models.ts.
# Newer Gemini models need paid Gateway credits (the free tier only serves 2.5).
# AI_MODEL_TEASER="google/gemini-3.8-flash"
# AI_MODEL_READING="google/gemini-4-argon"
# AI_MODEL_CHAT="google/gemini-3.8-flash"
# AI_MODEL_FALLBACK="google/gemini-3.8-flash"
